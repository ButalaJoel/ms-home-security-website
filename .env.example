# Where products, prices and contact details come from.
#   pos    = the POS server (live data). On Vercel, /api/public/* is passed to the POS server by vercel.json.
#   sample = the built-in sample data in src/data (default when this is not set).
VITE_DATA_SOURCE=sample

# Only for testing against a POS server running on this computer, e.g. http://localhost:5000
VITE_POS_API_URL=
